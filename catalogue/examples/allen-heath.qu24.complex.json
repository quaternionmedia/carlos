{
  "format": "carlos.patch",
  "version": 3,
  "name": "Front of house: keys, drums and sampler in, mains and a monitor out",
  "modules": [
    {
      "id": "desk",
      "type": "allen-heath.qu24",
      "view": "back",
      "parameters": {
        "lr_fader": 105
      }
    },
    {
      "id": "nord",
      "type": "nord.stage-3",
      "view": "back",
      "parameters": {}
    },
    {
      "id": "dfam",
      "type": "moog.dfam",
      "view": "back",
      "parameters": {}
    },
    {
      "id": "ko2",
      "type": "teenage-engineering.ep-133",
      "view": "front",
      "parameters": {}
    }
  ],
  "connections": [
    {
      "source": {
        "module": "nord",
        "jack": "out_l"
      },
      "target": {
        "module": "desk",
        "jack": "mic_in_1"
      }
    },
    {
      "source": {
        "module": "nord",
        "jack": "out_r"
      },
      "target": {
        "module": "desk",
        "jack": "mic_in_2"
      }
    },
    {
      "source": {
        "module": "dfam",
        "jack": "audio_out"
      },
      "target": {
        "module": "desk",
        "jack": "mic_in_3"
      }
    },
    {
      "source": {
        "module": "ko2",
        "jack": "line_out"
      },
      "target": {
        "module": "desk",
        "jack": "mic_in_4"
      }
    },
    {
      "source": {
        "module": "desk",
        "jack": "mix_out_1"
      },
      "target": {
        "module": "nord",
        "jack": "monitor_in"
      }
    }
  ],
  "groups": [
    {
      "id": "row-instruments",
      "kind": "row",
      "label": "Instruments",
      "members": [
        "nord",
        "dfam",
        "ko2"
      ]
    },
    {
      "id": "row-signal-path",
      "kind": "row",
      "label": "Signal path",
      "members": [
        "desk"
      ]
    }
  ]
}
